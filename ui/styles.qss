/* ==============================================================================
   КИНЕМАТОГРАФИЧНАЯ ДИЗАЙН-СИСТЕМА (ЧИСТЫЙ PyQt6)
   ============================================================================== */

/* Главный фон приложения — глубокий угольный черный, как в кинотеатре */
QMainWindow, QStackedWidget {
    background-color: #0E0E10;
}

/* --- ВЕРХНЯЯ ШАПКА (HEADER) --- */
QWidget#headerBar {
    background-color: #16161A;
    border-bottom: 1px solid #222227;
}

/* Строка поиска в стиле Кинопоиска */
QLineEdit#searchBar {
    background-color: #1F1F24;
    border: 1px solid #2D2D34;
    border-radius: 10px;
    padding: 10px 16px;
    color: #FFFFFF;
    font-size: 14px;
}
QLineEdit#searchBar:focus {
    border: 1px solid #FF6600; /* Фирменный оранжевый фокус */
    background-color: #26262C;
}

/* --- СЕТКА И КАРТОЧКИ ФИЛЬМОВ --- */
/* Сама карточка-постер */
QFrame#movieCard {
    background-color: #16161A;
    border-radius: 12px;
}

/* Заглушка, если нет картинки-обложки */
QLabel#coverPlaceholder {
    color: #52525B;
    background-color: #1F1F24;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 500;
}

/* Текстовый блок информации поверх постера при наведении */
QLabel#movieTitle {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: bold;
    background: transparent;
}
QLabel#movieMeta {
    color: #A1A1AA;
    font-size: 12px;
    background: transparent;
}

/* --- КНОПКИ ДЕЙСТВИЯ --- */
/* Фирменная оранжевая кнопка «Смотреть» */
QPushButton#actionButton {
    background-color: #FF6600;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 10px 24px;
    font-weight: 600;
    font-size: 14px;
}
QPushButton#actionButton:hover {
    background-color: #E05200; /* Слегка темнеет при наведении */
}
QPushButton#actionButton:pressed {
    background-color: #B84300; /* Утапливается при клике */
}

/* Нижние системные кнопки (Настройки, Тема) */
QPushButton#sysButton {
    background-color: #16161A;
    border: 1px solid #2D2D34;
    color: #A1A1AA;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
}
QPushButton#sysButton:hover {
    border: 1px solid #4B4B55;
    color: #FFFFFF;
    background-color: #1F1F24;
}

/* --- UX-ОСТРОВ «ПРОДОЛЖИТЬ ПРОСМОТР» --- */
QFrame#continueIsland {
    background-color: #16161A;
    border: 1px solid #FF6600; /* Тонкий оранжевый контур */
    border-radius: 20px;
}
QFrame#continueIsland QLabel {
    color: #FFFFFF;
    font-size: 14px;
}
QPushButton#closeIslandButton {
    background-color: transparent;
    color: #71717A;
    border: none;
    font-size: 20px;
}
QPushButton#closeIslandButton:hover {
    color: #EF4444; /* Крестик краснеет при наведении */
}

