/* ==============================================================================
   ДИЗАЙН-СИСТЕМА AMAGI-PLAYER (PREMIUM OLED MINIMALISM)
   ============================================================================== */

/* Базовый системный шрифт — строгий, дорогой без засечек (как на логотипе) */
* {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

/* Абсолютный OLED-черный фон для бесконечного контраста */
QMainWindow, QStackedWidget, QScrollArea, QWidget#gridContainer {
    background-color: #000000;
}

/* --- ВЕРХНЯЯ ШАПКА (HEADER) --- */
QWidget#headerBar {
    background-color: #000000;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08); /* Тончайшая белая нить-разделитель */
}

/* Поисковая строка в дорогой белой рамке */
QLineEdit#searchBar {
    background-color: #000000;
    border: 1px solid rgba(255, 255, 255, 0.25); /* Строгая благородная белая рамка */
    border-radius: 8px; /* Чуть более строгие углы вместо круглых */
    padding: 10px 16px;
    color: #FFFFFF;
    font-size: 13px;
    letter-spacing: 1px;
}
QLineEdit#searchBar:focus {
    border: 1px solid #FFFFFF; /* Рамка вспыхивает чистым белым при клике */
    background-color: #050505;
}

/* --- ТЕКСТОВЫЕ БЛОКИ (ПАФОСНЫЙ БЕЛЫЙ ШРИФТ AMAGI) --- */
QLabel#logoLabel {
    color: #FFFFFF; 
    font-size: 22px; 
    font-weight: 900; 
    letter-spacing: 6px; /* Разреженный пафосный стиль */
}

QLabel#sectionTitle {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 3px; /* Дублируем пафосный стиль логотипа на заголовки */
    text-transform: uppercase; /* Всегда заглавные */
}

/* --- КНОПКИ ДЕЙСТВИЯ --- */
/* Монолитная белая кнопка «Смотреть» для острова */
QPushButton#actionButton {
    background-color: #FFFFFF;
    color: #000000;
    border: none;
    border-radius: 6px;
    padding: 10px 22px;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
}
QPushButton#actionButton:hover {
    background-color: rgba(255, 255, 255, 0.9);
}

/* Тонкие прозрачные системные кнопки */
QPushButton#sysButton {
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.6);
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
}
QPushButton#sysButton:hover {
    border: 1px solid #FFFFFF;
    color: #FFFFFF;
    background-color: rgba(255, 255, 255, 0.05);
}

/* --- ПАРЯЩИЙ ОСТРОВ «ПРОДОЛЖИТЬ ПРОСМОТР» (LIQUID GLASS) --- */
QFrame#continueIsland {
    background-color: rgba(255, 255, 255, 0.05); /* Ультра-прозрачное жидкое стекло */
    border: 1px solid rgba(255, 255, 255, 0.15);  /* Едва заметный ледяной контур */
    border-radius: 12px;                          /* Строгая современная геометрия */
}
QFrame#continueIsland QLabel {
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
}
QPushButton#closeIslandButton {
    background-color: transparent;
    color: rgba(255, 255, 255, 0.4);
    border: none;
    font-size: 18px;
    font-weight: 300;
}
QPushButton#closeIslandButton:hover {
    color: #FFFFFF;
}
